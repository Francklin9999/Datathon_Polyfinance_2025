# ============================================
# AWS Configuration (REQUIRED for Voice Chat)
# ============================================

# AWS Region (default: us-east-1)
AWS_REGION=us-east-1

# AWS Access Credentials (REQUIRED)
# Get these from AWS Console > IAM > Users > Your User > Security Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ============================================
# S3 Configuration (Optional but Recommended)
# ============================================
# S3 bucket name for Transcribe audio files
# Create a bucket in S3 first, then set the name here
# If not set, uses "polyfinance-temp" as default
S3_BUCKET_NAME=polyfinance-temp


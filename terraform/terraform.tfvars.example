# Example Terraform variables file
# Copy this to terraform.tfvars and fill in your values

aws_region   = "us-east-1"
environment  = "dev"
project_name = "polyfinance2025"

# S3 Configuration
s3_bucket_name        = "polyfinance-regulatory-docs"
enable_s3_versioning  = true
s3_lifecycle_days     = 90

# OpenSearch Configuration
opensearch_domain_name     = "polyfinance-regulatory-search"
opensearch_instance_type   = "t3.small.search"
opensearch_instance_count = 1
opensearch_volume_size    = 20
opensearch_master_enabled = false

# Network Configuration (for production)
# allowed_cidr_blocks = ["10.0.0.0/16"]

# Bedrock Model Access
# Note: Model access must be requested in AWS Bedrock Console
bedrock_model_access = [
  "anthropic.claude-3-5-sonnet-20241022-v2:0",
  "anthropic.claude-3-opus-20240229-v1:0",
  "anthropic.claude-3-sonnet-20240229-v1:0"
]

# IAM Configuration
create_iam_roles = true


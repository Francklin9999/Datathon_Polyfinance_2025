      "forward_looking_statements": [
        {
          "statement": "In September 2024, we agreed to sell our remaining interest in DIRECTV to TPG, which we expect to close in mid-2025.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 103978
        },
        {
          "statement": "We believe our fixed wireline and mobile approach will differentiate our services and provide us with additional convergence growth opportunities in the future as bandwidth demands continue to grow.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 106601
        },
        {
          "statement": "artificial intelligence (AI) are expected to continue to drive greater demand for broadband, which we believe will allow us to capitalize on our fiber and 5G deployments.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 107338
        },
        {
          "statement": "We plan for about 70% of our wireless network traffic to flow across open-capable platforms by late 2026.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 108226
        },
        {
          "statement": "Beginning in 2025, we expect to scale this Open RAN environment throughout our wireless network in coordination with multiple suppliers.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 108351
        },
        {
          "statement": "We believe the move to an open, agile, programmable wireless network positions us to quickly capitalize on the next generation of wireless technology and spectrum when it becomes available.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 108469
        },
        {
          "statement": "We expect to continue to invest significant capital in expanding our network capacity, as well as obtaining additional spectrum, when available, that meets our long-term needs.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 109974
        },
        {
          "statement": "Some of the services we have offered historically are in secular decline and, going forward, we will focus on our owned and operated connectivity services powered by 5G and fiber as well as evaluating opportunities where we can turn down existing copper infrastructure.",
          "pattern": "going\\s+forward",
          "sentiment": 0.0,
          "position": 117451
        },
        {
          "statement": "We believe our investment in expanding our industry-leading fiber network positions us to be a leader in wired connectivity.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 118445
        },
        {
          "statement": "We believe that our flexible platform, with a broadband and wireless connection, is the most efficient way to transport direct-to-consumer video and data experiences both at home and on mobile devices.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 118738
        },
        {
          "statement": "Employee Development We believe our success depends on our employees’ success and that all employees must have the skills they need to thrive.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 130036
        },
        {
          "statement": "We believe in attracting and hiring talented people who represent a mix of backgrounds and experiences.",
          "pattern": "we\\s+(?:expect|anticipate|believe|plan|intend|forecast|project)",
          "sentiment": 0.0,
          "position": 132743
        },
        {
          "statement": "in this document, including the matters contained under the heading “Cautionary Language Concerning Forward-Looking Statements,” you should carefully read the matters described below.",
          "pattern": "forward-looking",
          "sentiment": 0.0,

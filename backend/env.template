# ============================================
# AWS Configuration (REQUIRED for Voice Chat)
# ============================================

# AWS Region (default: us-east-1)
AWS_REGION=us-east-1

# AWS Access Credentials (REQUIRED)
# Get these from AWS Console > IAM > Users > Your User > Security Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ============================================
# S3 Configuration (Optional but Recommended)
# ============================================
# S3 bucket name for Transcribe audio files
# Create a bucket in S3 first, then set the name here
# If not set, uses "intellirisk-temp" as default
S3_BUCKET_NAME=intellirisk-temp

# ============================================
# External API Keys (Optional)
# ============================================
# NewsAPI Key (Free tier: 100 requests/day)
# Get your free API key from: https://newsapi.org/register
# NewsAPI is used for news sentiment analysis and lawsuit mentions
NEWSAPI_KEY=your_newsapi_key_here

# CourtListener API Key (Optional - free tier available)
# Register at: https://www.courtlistener.com/api/rest-info/
# CourtListener is used for lawsuit tracking from court records
COURTLISTENER_API_KEY=your_courtlistener_api_key_here

